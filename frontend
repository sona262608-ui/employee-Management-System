```html
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Employee Management System</title>

<style>

/* =========================
   BASIC
========================= */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: Arial, sans-serif;
}

body {
    background: #f4f6f9;
    color: #1f2937;
}

/* =========================
   LAYOUT
========================= */

.container {
    display: flex;
    min-height: 100vh;
}

/* =========================
   SIDEBAR
========================= */

.sidebar {
    width: 230px;
    background: #1f2937;
    color: white;
    padding: 25px 18px;
    position: fixed;
    height: 100vh;
}

.sidebar h2 {
    text-align: center;
    font-size: 30px;
}

.logo-text {
    text-align: center;
    color: #cbd5e1;
    font-size: 12px;
    margin-top: 5px;
    margin-bottom: 35px;
}

.sidebar a {
    display: block;
    text-decoration: none;
    color: white;
    padding: 13px;
    margin: 8px 0;
    border-radius: 7px;
    cursor: pointer;
}

.sidebar a:hover {
    background: #374151;
}

/* =========================
   MAIN
========================= */

.main {
    margin-left: 230px;
    padding: 30px;
    width: calc(100% - 230px);
}

.top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 25px;
}

.top h1 {
    font-size: 28px;
}

.top p {
    color: #6b7280;
    margin-top: 5px;
}

/* =========================
   BUTTON
========================= */

button {
    border: none;
    padding: 10px 16px;
    border-radius: 6px;
    cursor: pointer;
    background: #2563eb;
    color: white;
}

button:hover {
    background: #1d4ed8;
}

.delete {
    background: #dc2626;
}

.delete:hover {
    background: #b91c1c;
}

/* =========================
   DASHBOARD CARDS
========================= */

.cards {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin-bottom: 30px;
}

.card {
    background: white;
    padding: 25px;
    border-radius: 10px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.08);
}

.card h3 {
    font-size: 14px;
    color: #6b7280;
}

.card p {
    font-size: 28px;
    font-weight: bold;
    margin-top: 12px;
}

/* =========================
   TABLE
========================= */

.table-box {
    background: white;
    padding: 25px;
    border-radius: 10px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    overflow-x: auto;
}

.table-box h2 {
    margin-bottom: 20px;
}

table {
    width: 100%;
    border-collapse: collapse;
    min-width: 750px;
}

th,
td {
    padding: 13px;
    text-align: left;
    border-bottom: 1px solid #e5e7eb;
}

th {
    background: #f9fafb;
}

td button {
    padding: 6px 10px;
    margin-right: 4px;
}

/* =========================
   SEARCH
========================= */

.tools {
    display: flex;
    gap: 15px;
    margin-bottom: 20px;
}

.tools input,
.tools select {
    padding: 11px;
    border: 1px solid #d1d5db;
    border-radius: 6px;
}

.tools input {
    width: 300px;
}

/* =========================
   FORM
========================= */

.form-box {
    background: white;
    padding: 25px;
    border-radius: 10px;
    max-width: 650px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.08);
}

form {
    display: flex;
    flex-direction: column;
}

form label {
    margin-top: 15px;
    margin-bottom: 6px;
    font-weight: bold;
}

form input,
form select {
    padding: 11px;
    border: 1px solid #d1d5db;
    border-radius: 6px;
}

form button {
    margin-top: 25px;
}

/* =========================
   STATUS
========================= */

.active {
    color: green;
    font-weight: bold;
}

.inactive {
    color: red;
    font-weight: bold;
}

/* =========================
   HIDDEN
========================= */

.hidden {
    display: none;
}

/* =========================
   MESSAGE
========================= */

.message {
    margin-bottom: 20px;
    padding: 12px;
    border-radius: 6px;
    display: none;
}

.success {
    background: #dcfce7;
    color: #166534;
}

.error {
    background: #fee2e2;
    color: #991b1b;
}

/* =========================
   RESPONSIVE
========================= */

@media(max-width: 1000px) {

    .cards {
        grid-template-columns: repeat(2, 1fr);
    }
}

@media(max-width: 700px) {

    .sidebar {
        position: relative;
        width: 100%;
        height: auto;
    }

    .container {
        display: block;
    }

    .main {
        margin-left: 0;
        width: 100%;
        padding: 20px;
    }

    .cards {
        grid-template-columns: 1fr;
    }

    .top {
        flex-direction: column;
        align-items: flex-start;
        gap: 15px;
    }

    .tools {
        flex-direction: column;
    }

    .tools input {
        width: 100%;
    }
}

</style>
</head>


<body>

<div class="container">

<!-- =========================
     SIDEBAR
========================= -->

<aside class="sidebar">

    <h2>EMS</h2>

    <p class="logo-text">
        Employee Management
    </p>

    <a onclick="showSection('dashboard')">
        Dashboard
    </a>

    <a onclick="showSection('employees')">
        Employees
    </a>

    <a onclick="showSection('addEmployee')">
        Add Employee
    </a>

</aside>


<!-- =========================
     MAIN CONTENT
========================= -->

<main class="main">


<!-- =========================
     DASHBOARD
========================= -->

<section id="dashboard">

    <div class="top">

        <div>
            <h1>Dashboard</h1>

            <p>
                Employee Management System
            </p>
        </div>

    </div>


    <!-- CARDS -->

    <div class="cards">

        <div class="card">

            <h3>
                Total Employees
            </h3>

            <p id="totalEmployees">
                0
            </p>

        </div>


        <div class="card">

            <h3>
                Active Employees
            </h3>

            <p id="activeEmployees">
                0
            </p>

        </div>


        <div class="card">

            <h3>
                Departments
            </h3>

            <p id="totalDepartments">
                0
            </p>

        </div>


        <div class="card">

            <h3>
                Average Salary
            </h3>

            <p id="averageSalary">
                ₹0
            </p>

        </div>

    </div>


    <!-- RECENT EMPLOYEES -->

    <div class="table-box">

        <h2>
            Recent Employees
        </h2>

        <table>

            <thead>

                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Department</th>
                    <th>Position</th>
                </tr>

            </thead>

            <tbody id="recentEmployees">

            </tbody>

        </table>

    </div>

</section>


<!-- =========================
     EMPLOYEES
========================= -->

<section id="employees" class="hidden">

    <div class="top">

        <div>

            <h1>
                Employees
            </h1>

            <p>
                Manage employee records
            </p>

        </div>

        <button onclick="showSection('addEmployee')">
            + Add Employee
        </button>

    </div>


    <!-- SEARCH -->

    <div class="tools">

        <input
            type="text"
            id="search"
            placeholder="Search employee..."
            onkeyup="displayEmployees()"
        >


        <select
            id="departmentFilter"
            onchange="displayEmployees()"
        >

            <option value="">
                All Departments
            </option>

            <option value="IT">
                IT
            </option>

            <option value="HR">
                HR
            </option>

            <option value="Finance">
                Finance
            </option>

            <option value="Marketing">
                Marketing
            </option>

        </select>

    </div>


    <!-- MESSAGE -->

    <div id="employeeMessage"
         class="message">
    </div>


    <!-- TABLE -->

    <div class="table-box">

        <table>

            <thead>

                <tr>

                    <th>ID</th>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Department</th>
                    <th>Position</th>
                    <th>Salary</th>
                    <th>Status</th>
                    <th>Action</th>

                </tr>

            </thead>

            <tbody id="employeeTable">

            </tbody>

        </table>

    </div>

</section>


<!-- =========================
     ADD / EDIT EMPLOYEE
========================= -->

<section id="addEmployee" class="hidden">

    <div class="top">

        <div>

            <h1 id="formTitle">
                Add Employee
            </h1>

            <p>
                Create or update employee record
            </p>

        </div>

    </div>


    <div id="formMessage"
         class="message">
    </div>


    <div class="form-box">

        <form id="employeeForm">

            <input
                type="hidden"
                id="editId"
            >


            <label>
                Employee Name
            </label>

            <input
                type="text"
                id="name"
                placeholder="Enter employee name"
                required
            >


            <label>
                Email
            </label>

            <input
                type="email"
                id="email"
                placeholder="Enter email"
                required
            >


            <label>
                Department
            </label>

            <select id="department" required>

                <option value="">
                    Select Department
                </option>

                <option value="IT">
                    IT
                </option>

                <option value="HR">
                    HR
                </option>

                <option value="Finance">
                    Finance
                </option>

                <option value="Marketing">
                    Marketing
                </option>

            </select>


            <label>
                Position
            </label>

            <input
                type="text"
                id="position"
                placeholder="Enter job position"
                required
            >


            <label>
                Salary
            </label>

            <input
                type="number"
                id="salary"
                placeholder="Enter salary"
                min="1"
                required
            >


            <label>
                Status
            </label>

            <select id="status">

                <option value="Active">
                    Active
                </option>

                <option value="Inactive">
                    Inactive
                </option>

            </select>


            <button type="submit">
                Save Employee
            </button>

        </form>

    </div>

</section>


</main>

</div>


<script>

/* =================================
   DJANGO API URL
================================= */

const API_URL =
    "http://127.0.0.1:8000/api/employees/";


/* =================================
   SHOW SECTION
================================= */

function showSection(section) {

    document
        .getElementById("dashboard")
        .classList.add("hidden");

    document
        .getElementById("employees")
        .classList.add("hidden");

    document
        .getElementById("addEmployee")
        .classList.add("hidden");


    document
        .getElementById(section)
        .classList.remove("hidden");


    if(section === "dashboard") {

        updateDashboard();

    }


    if(section === "employees") {

        displayEmployees();

    }

}


/* =================================
   LOAD EMPLOYEES FROM DJANGO
================================= */

async function getEmployees() {

    try {

        const response =
            await fetch(API_URL);


        if(!response.ok) {

            throw new Error(
                "Unable to connect to server"
            );

        }


        return await response.json();

    }

    catch(error) {

        showMessage(
            "employeeMessage",
            "Backend server is not running.",
            "error"
        );

        return [];

    }

}


/* =================================
   DISPLAY EMPLOYEES
================================= */

async function displayEmployees() {

    const table =
        document.getElementById(
            "employeeTable"
        );


    const employees =
        await getEmployees();


    const search =
        document.getElementById(
            "search"
        ).value.toLowerCase();


    const department =
        document.getElementById(
            "departmentFilter"
        ).value;


    table.innerHTML = "";


    const filtered =
        employees.filter(emp => {

            const matchesSearch =
                emp.name
                    .toLowerCase()
                    .includes(search) ||

                emp.email
                    .toLowerCase()
                    .includes(search);


            const matchesDepartment =
                department === "" ||

                emp.department === department;


            return (
                matchesSearch &&
                matchesDepartment
            );

        });


    filtered.forEach(emp => {

        const row =
            document.createElement("tr");


        row.innerHTML = `

            <td>${emp.id}</td>

            <td>${emp.name}</td>

            <td>${emp.email}</td>

            <td>${emp.department}</td>

            <td>${emp.position}</td>

            <td>
                ₹${Number(emp.salary)
                    .toLocaleString()}
            </td>

            <td class="${
                emp.status === "Active"
                ? "active"
                : "inactive"
            }">

                ${emp.status}

            </td>

            <td>

                <button
                    onclick="editEmployee(${emp.id})">

                    Edit

                </button>


                <button
                    class="delete"
                    onclick="deleteEmployee(${emp.id})">

                    Delete

                </button>

            </td>

        `;


        table.appendChild(row);

    });

}


/* =================================
   ADD EMPLOYEE
================================= */

document
.getElementById("employeeForm")
.addEventListener(
    "submit",
    async function(event) {

        event.preventDefault();


        const id =
            document.getElementById(
                "editId"
            ).value;


        const employee = {

            name:
                document.getElementById(
                    "name"
                ).value.trim(),

            email:
                document.getElementById(
                    "email"
                ).value.trim(),

            department:
                document.getElementById(
                    "department"
                ).value,

            position:
                document.getElementById(
                    "position"
                ).value.trim(),

            salary:
                Number(
                    document.getElementById(
                        "salary"
                    ).value
                ),

            status:
                document.getElementById(
                    "status"
                ).value

        };


        try {

            let response;


            /* UPDATE */

            if(id) {

                response =
                    await fetch(
                        API_URL + id + "/",
                        {

                            method: "PUT",

                            headers: {
                                "Content-Type":
                                    "application/json"
                            },

                            body:
                                JSON.stringify(
                                    employee
                                )

                        }
                    );

            }


            /* CREATE */

            else {

                response =
                    await fetch(
                        API_URL,
                        {

                            method: "POST",

                            headers: {
                                "Content-Type":
                                    "application/json"
                            },

                            body:
                                JSON.stringify(
                                    employee
                                )

                        }
                    );

            }


            if(!response.ok) {

                const errorData =
                    await response.json();

                throw new Error(
                    JSON.stringify(errorData)
                );

            }


            document
                .getElementById(
                    "employeeForm"
                )
                .reset();


            document
                .getElementById(
                    "editId"
                ).value = "";


            document
                .getElementById(
                    "formTitle"
                ).innerText =
                    "Add Employee";


            showSection("employees");


            showMessage(
                "employeeMessage",
                id
                ? "Employee updated successfully!"
                : "Employee added successfully!",
                "success"
            );

        }


        catch(error) {

            showMessage(
                "formMessage",
                "Unable to save employee. Check your input and backend.",
                "error"
            );

        }

    }
);


/* =================================
   EDIT EMPLOYEE
================================= */

async function editEmployee(id) {

    const employees =
        await getEmployees();


    const employee =
        employees.find(
            emp => emp.id === id
        );


    if(!employee) {

        return;

    }


    document
        .getElementById("editId")
        .value = employee.id;


    document
        .getElementById("name")
        .value = employee.name;


    document
        .getElementById("email")
        .value = employee.email;


    document
        .getElementById("department")
        .value = employee.department;


    document
        .getElementById("position")
        .value = employee.position;


    document
        .getElementById("salary")
        .value = employee.salary;


    document
        .getElementById("status")
        .value = employee.status;


    document
        .getElementById("formTitle")
        .innerText =
            "Edit Employee";


    showSection("addEmployee");

}


/* =================================
   DELETE EMPLOYEE
================================= */

async function deleteEmployee(id) {

    const confirmDelete =
        confirm(
            "Are you sure you want to delete this employee?"
        );


    if(!confirmDelete) {

        return;

    }


    try {

        const response =
            await fetch(
                API_URL + id + "/",
                {
                    method: "DELETE"
                }
            );


        if(!response.ok) {

            throw new Error(
                "Delete failed"
            );

        }


        displayEmployees();


        updateDashboard();


        showMessage(
            "employeeMessage",
            "Employee deleted successfully!",
            "success"
        );

    }


    catch(error) {

        showMessage(
            "employeeMessage",
            "Unable to delete employee.",
            "error"
        );

    }

}


/* =================================
   DASHBOARD
================================= */

async function updateDashboard() {

    const employees =
        await getEmployees();


    /* TOTAL */

    document
        .getElementById(
            "totalEmployees"
        )
        .innerText =
            employees.length;


    /* ACTIVE */

    const active =
        employees.filter(
            emp => emp.status === "Active"
        ).length;


    document
        .getElementById(
            "activeEmployees"
        )
        .innerText =
            active;


    /* DEPARTMENTS */

    const departments =
        new Set(
            employees.map(
                emp => emp.department
            )
        );


    document
        .getElementById(
            "totalDepartments"
        )
        .innerText =
            departments.size;


    /* AVERAGE SALARY */

    const totalSalary =
        employees.reduce(
            (sum, emp) =>
                sum + Number(emp.salary),
            0
        );


    const average =
        employees.length > 0
        ? totalSalary / employees.length
        : 0;


    document
        .getElementById(
            "averageSalary"
        )
        .innerText =
            "₹" +
            Math.round(average)
                .toLocaleString();


    /* RECENT EMPLOYEES */

    const recent =
        document.getElementById(
            "recentEmployees"
        );


    recent.innerHTML = "";


    employees
        .slice(0, 5)
        .forEach(emp => {

            recent.innerHTML += `

                <tr>

                    <td>${emp.id}</td>

                    <td>${emp.name}</td>

                    <td>${emp.department}</td>

                    <td>${emp.position}</td>

                </tr>

            `;

        });

}


/* =================================
   MESSAGE
================================= */

function showMessage(
    elementId,
    message,
    type
) {

    const element =
        document.getElementById(
            elementId
        );


    element.innerText =
        message;


    element.className =
        "message " + type;


    element.style.display =
        "block";


    setTimeout(
        () => {

            element.style.display =
                "none";

        },
        3000
    );

}


/* =================================
   START DASHBOARD
================================= */

updateDashboard();

</script>

</body>
</html>
```
